{
	"name": "df_plata_bja_pagos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "BJA_bronce_pagos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_bja_pagos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "LimpiezaBronze"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          ci_beneficiaria as string,",
				"          concepto_pago as string,",
				"          monto_bs as string,",
				"          fecha_pago as string,",
				"          estado_pago as string,",
				"          canal_pago as string,",
				"          nro_comprobante as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(pago_id) AS pago_id,\\n    TRIM(ci_beneficiaria) AS ci_beneficiaria,\\n    TRIM(concepto_pago) AS concepto_pago,\\n    TRIM(monto_bs) AS monto_bs,\\n    TRIM(fecha_pago) AS fecha_pago,\\n    TRIM(estado_pago) AS estado_pago,\\n    TRIM(canal_pago) AS canal_pago,\\n    TRIM(nro_comprobante) AS nro_comprobante\\nFROM bronze.bja_pagos\\nWHERE pago_id IS NOT NULL AND TRIM(pago_id) <> \\'\\'',",
				"     format: 'query') ~> source1",
				"source1 derive(ci_beneficiaria = replace(ci_beneficiaria, '-', ''),",
				"          monto_bs = toDecimal(monto_bs),",
				"          fecha_pago = toDate(fecha_pago, 'yyyy-MM-dd'),",
				"          canal_pago = initCap(coalesce(canal_pago, 'No Registrado')),",
				"          nro_comprobante = coalesce(nro_comprobante, 'Sin Comprobante'),",
				"          pago_id = toInteger(pago_id),",
				"          estado_pago = replace(initCap(estado_pago), 'Paqado', 'Pagado'),",
				"          concepto_pago = replace(replace(initCap(concepto_pago), 'Rpenatal', 'Prenatal'), 'Istitucional', 'Institucional')) ~> LimpiezaBronze",
				"LimpiezaBronze sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pago_id as string,",
				"          ci_beneficiaria as string,",
				"          concepto_pago as string,",
				"          monto_bs as string,",
				"          fecha_pago as string,",
				"          estado_pago as string,",
				"          canal_pago as string,",
				"          nro_comprobante as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ci_beneficiaria,",
				"          concepto_pago,",
				"          estado_pago,",
				"          canal_pago,",
				"          nro_comprobante,",
				"          pago_id,",
				"          fecha_pago,",
				"          monto_bs",
				"     )) ~> sink1"
			]
		}
	}
}