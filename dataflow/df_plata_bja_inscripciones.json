{
	"name": "df_plata_bja_inscripciones",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "BJA_bronce_inscripciones",
						"type": "DatasetReference"
					},
					"name": "bronceIncripciones"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_bja_inscripciones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiezaInscripciones"
				}
			],
			"scriptLines": [
				"source(output(",
				"          inscripcion_id as string,",
				"          ci_beneficiaria as string,",
				"          establecimiento_id as string,",
				"          fecha_inscripcion as string,",
				"          semana_gestacion as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(inscripcion_id) AS inscripcion_id,\\n    TRIM(ci_beneficiaria) AS ci_beneficiaria,\\n    TRIM(establecimiento_id) AS establecimiento_id,\\n    TRIM(fecha_inscripcion) AS fecha_inscripcion,\\n    TRIM(semana_gestacion) AS semana_gestacion,\\n    TRIM(estado) AS estado\\nFROM bronze.bja_inscripciones\\nWHERE inscripcion_id IS NOT NULL AND TRIM(inscripcion_id) <> \\'\\'',",
				"     format: 'query') ~> bronceIncripciones",
				"bronceIncripciones derive(inscripcion_id = toInteger(inscripcion_id),",
				"          establecimiento_id = toInteger(establecimiento_id),",
				"          semana_gestacion = toInteger(semana_gestacion),",
				"          fecha_inscripcion = toDate(fecha_inscripcion, 'yyyy-MM-dd'),",
				"          estado = initCap(estado)) ~> limpiezaInscripciones",
				"limpiezaInscripciones sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          inscripcion_id as string,",
				"          ci_beneficiaria as string,",
				"          establecimiento_id as string,",
				"          fecha_inscripcion as string,",
				"          semana_gestacion as string,",
				"          estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ci_beneficiaria,",
				"          estado,",
				"          inscripcion_id,",
				"          establecimiento_id,",
				"          fecha_inscripcion,",
				"          semana_gestacion",
				"     )) ~> sink1"
			]
		}
	}
}