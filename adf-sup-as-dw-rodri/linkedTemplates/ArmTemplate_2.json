						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          ci_beneficiaria,",
						"          presion_arterial,",
						"          resultado,",
						"          control_prenatal_id,",
						"          establecimiento_id,",
						"          nro_control,",
						"          semana_gestacion,",
